  {"type": "text", "id": "comp-2", "x": 80, "y": 744, "text": "GlassButton · Primary —— 深蓝渐变主按钮（#4C6FB4→#2F4C8F→#223660），圆角 15dp", "fontSize": 14, "fontFamily": 2, "color": "#16213E", "textAlign": "left"},
